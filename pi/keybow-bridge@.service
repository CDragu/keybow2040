[Unit]
Description=Original Keybow Pi Zero WH authenticated Windows bridge (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
SupplementaryGroups=gpio spi
WorkingDirectory=/home/%i/keybow2040
ExecStart=/home/%i/keybow2040/.venv/bin/python -m pi.bridge --backend real --config /home/%i/.keybow2040/pi.json
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
